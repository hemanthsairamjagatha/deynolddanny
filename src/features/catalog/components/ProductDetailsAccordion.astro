---
import type { ProductCardData } from '../types/product.types';

interface Props {
  product: ProductCardData;
}

const { product } = Astro.props;
---

<section class="border-t border-neutral-200/70 bg-white py-12 lg:py-16 text-neutral-900" aria-label="Technical Specifications">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-10 lg:gap-16">
      {/* Column 1: Size, Fit & Model Dimensions */}
      <div class="space-y-4">
        <h3 class="text-xs uppercase tracking-[0.2em] font-mono text-neutral-500">
          Tailoring & Measurements
        </h3>
        <ul class="space-y-2.5 text-xs text-neutral-700 leading-relaxed">
          {product.sizeAndFit && product.sizeAndFit.length > 0 ? (
            product.sizeAndFit.map((item) => (
              <li class="flex items-start gap-2">
                <span class="text-neutral-400 font-mono">—</span>
                <span>{item}</span>
              </li>
            ))
          ) : (
            <li class="flex items-start gap-2">
              <span class="text-neutral-400 font-mono">—</span>
              <span>Fits true to size. Take your normal Italian size.</span>
            </li>
          )}
        </ul>
      </div>

      {/* Column 2: Materials, Care & Sustainability */}
      <div class="space-y-4">
        <h3 class="text-xs uppercase tracking-[0.2em] font-mono text-neutral-500">
          Composition & Preservation
        </h3>
        <ul class="space-y-2.5 text-xs text-neutral-700 leading-relaxed">
          {product.compositionAndCare && product.compositionAndCare.length > 0 ? (
            product.compositionAndCare.map((item) => (
              <li class="flex items-start gap-2">
                <span class="text-neutral-400 font-mono">—</span>
                <span>{item}</span>
              </li>
            ))
          ) : (
            <li class="flex items-start gap-2">
              <span class="text-neutral-400 font-mono">—</span>
              <span>Crafted in Italy. Professional dry clean recommended.</span>
            </li>
          )}
        </ul>
      </div>
    </div>
  </div>
</section>

