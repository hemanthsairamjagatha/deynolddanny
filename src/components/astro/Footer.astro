---
// src/components/astro/Footer.astro
// Luxury Minimalist White Footer for DEYNOLD DANNY
---

<footer class="site-footer" id="footer">
  <div class="footer-container">
    <!-- Top 3-Column Navigation & Newsletter Section -->
    <div class="footer-top-grid">
      <!-- Column 1: GET TO KNOW US -->
      <div class="footer-col footer-col-nav">
        <h4 class="footer-col-title">GET TO KNOW US</h4>
        <ul class="footer-link-list">
          <li><a href="#search" class="footer-link">SEARCH</a></li>
          <li><a href="#about-us" class="footer-link">ABOUT US</a></li>
          <li><a href="#contact-us" class="footer-link">CONTACT US</a></li>
        </ul>
      </div>

      <!-- Column 2: CUSTOMER CARE -->
      <div class="footer-col footer-col-nav">
        <h4 class="footer-col-title">CUSTOMER CARE</h4>
        <ul class="footer-link-list">
          <li><a href="#return-exchange" class="footer-link">RETURN AND EXCHANGE POLICY</a></li>
          <li><a href="#privacy-policy" class="footer-link">PRIVACY POLICY</a></li>
          <li><a href="#shipping-delivery" class="footer-link">SHIPPING &amp; DELIVERY</a></li>
          <li><a href="#terms-condition" class="footer-link">TERMS AND CONDITION</a></li>
        </ul>
      </div>

      <!-- Column 3: Newsletter -->
      <div class="footer-col footer-col-newsletter">
        <h3 class="footer-heading-newsletter">Newsletter</h3>
        <p class="footer-text-newsletter">
          Never miss any news and be the first to know about sale and offers
        </p>
        <form class="footer-newsletter-form" action="#newsletter-signup" method="POST" onsubmit="event.preventDefault();">
          <div class="footer-input-group">
            <input
              type="email"
              name="email"
              placeholder="Email"
              required
              class="footer-email-input"
              aria-label="Email address for newsletter"
            />
            <button type="submit" class="footer-submit-btn" aria-label="Subscribe to newsletter">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- Bottom Row: Copyright, Attribution & Currency Selector -->
    <div class="footer-bottom-row">
      <div class="footer-copyright-wrap">
        <p class="footer-copyright-text">
          &copy; 2026 Deynold Danny, HANDCRAFTED BY <a href="https://www.pixenox.com" target="_blank" rel="noopener noreferrer" class="footer-pixenox-link">PIXENOX SOLUTIONS</a>
        </p>
      </div>

      <div class="footer-currency-wrap">
        <button type="button" class="footer-currency-btn" aria-label="Select currency and region">
          <span class="footer-currency-label">IN (INR ₹)</span>
          <svg class="footer-chevron-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </button>
      </div>
    </div>
  </div>
</footer>

<style>
  /* --------------------------------------------------------------------------
     SITE FOOTER COMPONENT - PURE WHITE BACKGROUND
     -------------------------------------------------------------------------- */
  .site-footer {
    width: 100%;
    background-color: #ffffff !important;
    color: #111111;
    border-top: 1px solid #ebebeb;
    padding: clamp(3rem, 5vw, 4.5rem) 0 2rem;
    font-family: var(--font-primary, 'Plus Jakarta Sans'), -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    position: relative;
    box-sizing: border-box;
  }

  .footer-container {
    width: 100%;
    max-width: 1520px;
    margin: 0 auto;
    padding: 0 clamp(1.25rem, 4vw, 3.5rem);
    box-sizing: border-box;
  }

  /* --------------------------------------------------------------------------
     TOP 3-COLUMN GRID
     -------------------------------------------------------------------------- */
  .footer-top-grid {
    display: grid;
    grid-template-columns: 334.2px 334.2px 1fr;
    column-gap: 0;
    row-gap: 2.5rem;
    align-items: start;
  }

  @media (max-width: 900px) {
    .footer-top-grid {
      grid-template-columns: 1fr;
      row-gap: 2.5rem;
    }
  }

  /* Column 3: Newsletter (Right-Aligned) */
  .footer-col-newsletter {
    max-width: 440px;
    width: 100%;
    justify-self: end;
  }

  @media (max-width: 900px) {
    .footer-col-newsletter {
      justify-self: start;
    }
  }

  .footer-heading-newsletter {
    font-family: inherit;
    font-size: 18px;
    font-weight: 400;
    line-height: 1.3;
    color: #111111;
    margin: 0 0 10px 0;
    letter-spacing: 0.01em;
  }

  .footer-text-newsletter {
    font-size: 13.5px;
    line-height: 1.55;
    color: #555555;
    margin: 0 0 20px 0;
  }

  .footer-newsletter-form {
    width: 100%;
  }

  .footer-input-group {
    display: flex;
    align-items: stretch;
    width: 100%;
    max-width: 320px;
  }

  .footer-email-input {
    flex: 1;
    min-width: 0;
    height: 42px;
    padding: 0 14px;
    background-color: #ffffff;
    border: 1px solid #111111;
    border-right: none;
    border-radius: 0;
    font-family: inherit;
    font-size: 13.5px;
    color: #111111;
    outline: none;
    box-sizing: border-box;
    transition: border-color 0.2s ease;
  }

  .footer-email-input::placeholder {
    color: #888888;
    opacity: 1;
  }

  .footer-email-input:focus {
    border-color: #000000;
  }

  .footer-submit-btn {
    width: 46px;
    height: 42px;
    flex-shrink: 0;
    background-color: #e5e5e5;
    border: 1px solid #111111;
    border-radius: 0;
    color: #111111;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-sizing: border-box;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
    padding: 0;
  }

  .footer-submit-btn:hover {
    background-color: #111111;
    color: #ffffff;
    border-color: #111111;
  }

  /* Columns 1 & 2: Navigation Links */
  .footer-col-nav {
    display: flex;
    flex-direction: column;
    width: 334.2px;
    max-width: 100%;
    margin: 0;
    padding: 0;
  }

  .footer-col-title {
    font-family: inherit;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #111111;
    margin: 0 0 18px 0;
  }

  .footer-link-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .footer-link {
    font-size: 12.5px;
    font-weight: 400;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #333333;
    text-decoration: none;
    display: inline-block;
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .footer-link:hover {
    color: #000000;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* --------------------------------------------------------------------------
     BOTTOM SUB-FOOTER ROW
     -------------------------------------------------------------------------- */
  .footer-bottom-row {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-top: 1.75rem;
    border-top: 1px solid #f0f0f0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.25rem;
  }

  .footer-copyright-wrap {
    flex: 1;
    min-width: 280px;
  }

  .footer-copyright-text {
    font-size: 12px;
    line-height: 1.6;
    letter-spacing: 0.03em;
    color: #555555;
    margin: 0;
  }

  .footer-pixenox-link {
    color: #111111;
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.2s ease;
  }

  .footer-pixenox-link:hover {
    color: #000000;
  }

  /* Currency / Region Selector */
  .footer-currency-wrap {
    display: flex;
    align-items: center;
  }

  .footer-currency-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: transparent;
    border: none;
    padding: 6px 4px;
    font-family: inherit;
    font-size: 12.5px;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: #111111;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }

  .footer-currency-btn:hover {
    opacity: 0.7;
  }

  .footer-chevron-icon {
    display: block;
    stroke-width: 2.5;
  }
</style>
