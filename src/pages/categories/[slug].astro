export async function getStaticPaths() {
  const allProducts = await fetchProducts();

  return CATEGORIES.map((cat) => {
    const catMatched = allProducts.filter(cat.matcher);
    // Complementary creations to ensure full luxury spread (15-17 items)
    const complementary = allProducts.filter((p) => !cat.matcher(p));
    // Category items first, then complementary total-look creations
    const fullSpread = [...catMatched, ...complementary];
    const products = fullSpread.length > 0 ? fullSpread : allProducts;

    return {
      params: { slug: cat.slug },
      props: {
        category: cat,
        products: products,
        allCategories: CATEGORIES.slice(0, 7) // Primary category filter pills
      }
    };
  });
}

const { category, products, allCategories } = Astro.props;

const pageTitle = `${category.title} | DEYNOLD DANNY`;
const pageDescription = category.description;

// Group products for the Brunello Cucinelli signature rhythmic catalog grid:
// Block 1: Hero Editorial Mosaic (first 4 products + 1 tall campaign card)
const mosaicProducts = products.slice(0, 4);

// Block 2: 3-column product row (products 4, 5, 6)
const secondRowProducts = products.slice(4, 7);

// Block 3: Editorial Duo Inset (between product rows)

// Block 4: Continuing 3-column product rows (products 7 onwards)
const remainingProducts = products.slice(7);
---

<StorefrontLayout title={pageTitle} description={pageDescription}>
  <main class="min-h-screen bg-white text-black">
    <div class="max-w-[1520px] mx-auto px-4 sm:px-6 lg:px-12 pt-8 pb-24">
      <!-- Breadcrumbs -->
      <nav aria-label="Breadcrumb" class="mb-8">
        <ol class="flex items-center gap-2 text-[11px] uppercase tracking-[0.2em] text-neutral-400 font-mono">
          <li>
            <a href="/" class="hover:text-black transition-colors underline underline-offset-4">Home</a>
          </li>
          <li class="select-none text-neutral-300">/</li>
          <li>
            <a href="/categories" class="hover:text-black transition-colors">Categories</a>
          </li>
          <li class="select-none text-neutral-300">/</li>
          <li class="text-neutral-900 font-medium" aria-current="page">
            {category.title}
          </li>
        </ol>
      </nav>

      <!-- Category Heading -->
      <div class="text-center max-w-2xl mx-auto mb-8 sm:mb-10">
        <h1 class="text-[36px] font-normal tracking-wider text-neutral-900 uppercase font-montserrat">
          {category.title}
        </h1>
      </div>

      <!-- Quick Category Filter Pills -->
      <div class="flex items-center justify-center flex-wrap gap-2 sm:gap-3 mb-12 border-b border-neutral-200/80 pb-6">
        <a
          href="/categories"
          class="px-4 py-2 text-[11px] font-mono uppercase tracking-wider rounded-full border border-neutral-300 text-neutral-700 hover:border-black hover:text-black transition-colors"
        >
          All Collections
        </a>
        {allCategories.map((cat) => (
          <a
            href={`/categories/${cat.slug}`}
            class={`px-4 py-2 text-[11px] font-mono uppercase tracking-wider rounded-full transition-all ${
              cat.slug === category.slug
                ? 'bg-neutral-900 text-white border border-neutral-900 shadow-sm'
                : 'border border-neutral-300 text-neutral-700 hover:border-black hover:text-black'
            }`}
          >
            {cat.title}
          </a>
        ))}
      </div>

      <!-- Category Editorial Grid (Brunello Cucinelli Signature Rhythmic Layout) -->
      <div class="catalog-editorial-grid">
        <!-- 1. Hero Editorial Mosaic (Block 1: 4 Products in 2x2 + 1 Tall Campaign Feature) -->
        {mosaicProducts.length > 0 && (
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-8 items-stretch mb-10 lg:mb-12">
            <!-- Left Side: 4 Products arranged in a 2x2 Grid -->
            <div class="grid grid-cols-2 gap-4 sm:gap-6">
              {mosaicProducts.map((product) => (
                <div class="flex justify-center w-full">
                  <ProductCard client:load product={product} />
                </div>
              ))}
            </div>

            <!-- Right Side: Tall Editorial Campaign Portrait (stretches to match 2 stacked rows) -->
            <div class="catalog-editorial-hero relative w-full h-full min-h-[460px] lg:min-h-0 bg-neutral-100 overflow-hidden group">
              <img
                src={category.heroEditorialImg}
                alt={category.heroEditorialTitle}
                class="w-full h-full object-cover object-top transition-transform duration-1000 ease-out group-hover:scale-105"
                loading="eager"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/10 to-transparent pointer-events-none" />
              <div class="absolute bottom-6 sm:bottom-8 left-6 sm:left-8 right-6 sm:right-8 text-white">
                <span class="text-[10px] sm:text-[11px] font-mono uppercase tracking-[0.3em] text-white/80 block mb-2">
                  {category.heroEditorialSubtitle}
                </span>
                <h3 class="text-xl sm:text-2xl lg:text-3xl font-serif uppercase tracking-wide text-white mb-2 font-normal">
                  {category.heroEditorialTitle}
                </h3>
                <p class="text-xs text-white/70 max-w-sm line-clamp-2 font-light hidden sm:block">
                  {category.description}
                </p>
              </div>
            </div>
          </div>
        )}

        <!-- 2. 3-Column Product Row (Block 2: Exactly 3 Products Side-by-Side) -->
        {secondRowProducts.length > 0 && (
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8 mb-10 lg:mb-12">
            {secondRowProducts.map((product) => (
              <div class="flex justify-center w-full">
                <ProductCard client:load product={product} />
              </div>
            ))}
          </div>
        )}

        <!-- 3. Editorial Duo Inset (Block 3: 2 Landscape Campaign Shots Side-by-Side) -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8 my-10 lg:my-14">
          <div class="group relative aspect-[4/3] sm:aspect-[16/11] overflow-hidden bg-neutral-100">
            <img
              src={category.duoEditorialLeftImg}
              alt={category.duoEditorialLeftTitle}
              class="w-full h-full object-cover object-center transition-transform duration-700 ease-out group-hover:scale-105"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/55 via-transparent to-transparent pointer-events-none" />
            <div class="absolute bottom-6 left-6 right-6 text-white">
              <span class="text-[10px] font-mono uppercase tracking-[0.25em] text-white/80 block mb-1">
                Sartorial Heritage
              </span>
              <h4 class="text-lg sm:text-xl font-serif uppercase tracking-wide text-white font-normal">
                {category.duoEditorialLeftTitle}
              </h4>
            </div>
          </div>

          <div class="group relative aspect-[4/3] sm:aspect-[16/11] overflow-hidden bg-neutral-100">
            <img
              src={category.duoEditorialRightImg}
              alt={category.duoEditorialRightTitle}
              class="w-full h-full object-cover object-center transition-transform duration-700 ease-out group-hover:scale-105"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/55 via-transparent to-transparent pointer-events-none" />
            <div class="absolute bottom-6 left-6 right-6 text-white">
              <span class="text-[10px] font-mono uppercase tracking-[0.25em] text-white/80 block mb-1">
                Atelier Craft
              </span>
              <h4 class="text-lg sm:text-xl font-serif uppercase tracking-wide text-white font-normal">
                {category.duoEditorialRightTitle}
              </h4>
            </div>
          </div>
        </div>

        <!-- 4. Continuing 3-Column Product Rows (Block 4: All Remaining Products in 3 Columns) -->
        {remainingProducts.length > 0 && (
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8 mb-10 lg:mb-14">
            {remainingProducts.map((product) => (
              <div class="flex justify-center w-full">
                <ProductCard client:load product={product} />
              </div>
            ))}
          </div>
        )}
      </div>
    </div>
  </main>
</StorefrontLayout>
