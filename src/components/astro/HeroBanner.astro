---
---

<section class="hero-section" id="hero">
  <!-- Centered Search Strip Matching Reference Image -->
  <div class="hero-search-strip">
    <form class="hero-search-box" action="#search" method="GET">
      <svg
        class="search-icon"
        width="19"
        height="19"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <circle cx="10.5" cy="10.5" r="7.5"></circle>
        <line x1="21" y1="21" x2="16" y2="16"></line>
      </svg>
      <input
        type="text"
        class="hero-search-input"
        placeholder="Type your search request"
        aria-label="Type your search request"
      />
      <button type="submit" class="hero-search-arrow" aria-label="Submit search request">
        <svg
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </button>
    </form>
  </div>

  <!-- Hero Visual Banner: Exact Size 1520.8 x 855 -->
  <div class="hero-banner-container">
    <img
      src="/hero-banner.png"
      alt="DEYNOLD DANNY - Modern Lifestyle Campaign 2026"
      class="hero-banner-img"
      width="1521"
      height="855"
      loading="eager"
    />

    <!-- Direct Editorial Typography Overlay -->
    <div class="hero-overlay-content">
      <h1 class="hero-headline">
        Knitwear: fine yarns
      </h1>

      <p class="hero-description">
        Discover our selection of fine knitwear, crafted with quality yarns and exquisite workmanship.
      </p>

      <div class="hero-actions">
        <a href="#shop" class="hero-btn">Shop Collection</a>
        <a href="#collections" class="hero-btn">Explore More</a>
      </div>
    </div>
  </div>
</section>
