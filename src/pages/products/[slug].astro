---
// src/pages/products/[slug].astro
import StorefrontLayout from '../../layouts/StorefrontLayout.astro';
import { fetchProducts, fetchProductBySlug } from '../../features/catalog/api/catalog.api';
import { getProductSlug } from '../../features/catalog/utils/product.utils';
import { ProductDetailExperience } from '../../features/catalog/components/ProductDetailExperience';
import StyleItWith from '../../features/catalog/components/StyleItWith.astro';
import RelatedProducts from '../../features/catalog/components/RelatedProducts.astro';
import type { ProductCardData } from '../../features/catalog/types/product.types';

export async function getStaticPaths() {
  const products = await fetchProducts();
  return products.map((product) => {
    const slug = getProductSlug(product);
    return {
      params: { slug },
      props: { product }
    };
  });
}

interface Props {
  product?: ProductCardData;
}

const { slug } = Astro.params;
const product = Astro.props.product || (slug ? await fetchProductBySlug(slug) : undefined);

if (!product) {
  return Astro.redirect('/404');
}

const pageTitle = `${product.title} | DEYNOLD DANNY`;
const pageDescription = product.description || `Explore ${product.title} in the DEYNOLD DANNY luxury collection.`;

const siteOrigin = (Astro.site?.toString() || 'https://deynolddanny.com').replace(/\/$/, '');
const rawImages = product.images && product.images.length > 0 ? product.images : [product.defaultImg];
const absoluteImages = rawImages.map((img) => (img.startsWith('http') ? img : `${siteOrigin}${img.startsWith('/') ? '' : '/'}${img}`));
const hasLiveVariants = product.variants && product.variants.length > 0;
const isProductAvailable =
  product.badge !== 'SOLD OUT' &&
  product.sizes.length > 0 &&
  (!hasLiveVariants || product.variants!.some((v) => Math.max(0, v.stock - v.reservedStock) > 0));
const priceValidUntil = new Date(Date.now() + 365 * 24 * 60 * 60 * 1000).toISOString().slice(0, 10);

// JSON-LD structured data
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": product.title,
  "image": absoluteImages,
  "description": pageDescription,
  "sku": product.sku || product.id,
  "url": `${siteOrigin}/products/${product.slug}`,
  "brand": {
    "@type": "Brand",
    "name": "DEYNOLD DANNY"
  },
  "offers": {
    "@type": "Offer",
    "url": `${siteOrigin}/products/${product.slug}`,
    "priceCurrency": product.price.includes('€') ? 'EUR' : 'INR',
    "price": product.priceNum,
    "priceValidUntil": priceValidUntil,
    "availability": isProductAvailable ? "https://schema.org/InStock" : "https://schema.org/OutOfStock",
    "itemCondition": "https://schema.org/NewCondition"
  }
};
const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": `${siteOrigin}/` },
    ...(product.category
      ? [{ "@type": "ListItem", "position": 2, "name": product.category, "item": `${siteOrigin}/categories/${encodeURIComponent(product.category.toLowerCase().replace(/[^a-z0-9]+/g, '-'))}` }]
      : []),
    { "@type": "ListItem", "position": product.category ? 3 : 2, "name": product.title, "item": `${siteOrigin}/products/${product.slug}` }
  ]
};
---

<StorefrontLayout title={pageTitle} description={pageDescription} ogType="product" ogImage={absoluteImages[0]}>
  {/* SEO JSON-LD */}
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd).replace(/</g, '\\u003c')} />

  <main id="main-content" class="min-h-screen bg-white">
    {/* Primary Interactive Island: Split-screen Gallery + Sticky Purchase Panel */}
    <ProductDetailExperience client:load product={product} />

    {/* Section 1: Style It With Merchandising */}
    {product.styleItWith && product.styleItWith.length > 0 && (
      <StyleItWith items={product.styleItWith} />
    )}

    {/* Section 2: Related Products / Suggestions */}
    {product.relatedProducts && product.relatedProducts.length > 0 && (
      <RelatedProducts items={product.relatedProducts} title="More Suggestions" />
    )}
  </main>
</StorefrontLayout>

