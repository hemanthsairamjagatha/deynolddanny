---
import Layout from '../layouts/Layout.astro';
import Header from '../components/layout/Header.astro';
import HeroBanner from '../features/home/components/HeroBanner.astro';
import CategoryGrid from '../features/home/components/CategoryGrid.astro';
import EditorialDuo from '../features/home/components/EditorialDuo.astro';
import ProductCarousel from '../features/catalog/components/ProductCarousel';
import CartDrawer from '../features/cart/components/CartDrawer';
import Footer from '../components/layout/Footer.astro';

import { fetchProducts } from '../features/catalog/api/catalog.api';
import {
  masteryProducts as defaultMastery,
  styleSpaceProducts as defaultStyleSpace,
  newsProducts as defaultNews
} from '../features/catalog/data/products';

const liveProducts = await fetchProducts();
const masteryProducts = liveProducts.length >= 4 ? liveProducts.slice(0, 4) : defaultMastery;
const styleSpaceProducts = liveProducts.length >= 8 ? liveProducts.slice(4, 8) : defaultStyleSpace;
const newsProducts = liveProducts.length >= 12 ? liveProducts.slice(8, 12) : defaultNews;
---

<Layout>
  <!-- Header with Two Tiers, Mobile Drawer & Cart Trigger -->
  <Header />

  <!-- Main Content Body -->
  <main>
    <!-- Hero Banner with Search Strip and Campaign Overlay -->
    <HeroBanner />

    <!-- 1. Thread of Mastery Carousel -->
    <ProductCarousel
      client:load
      id="thread-of-mastery"
      title="THREAD OF MASTERY"
      viewAllLink="#mastery"
      products={masteryProducts}
      sectionClass="mastery-section"
    />

    <!-- 2. 6 Editorial Categories (3x2 Grid) -->
    <CategoryGrid />

    <!-- 3. Style Space Carousel -->
    <ProductCarousel
      client:load
      id="style-space"
      title="STYLE SPACE"
      viewAllLink="#style-space"
      products={styleSpaceProducts}
      sectionClass="mastery-section"
    />

    <!-- 4. Editorial Duo (Scarpe & Accessori) -->
    <EditorialDuo />

    <!-- 5. Latest News Carousel -->
    <ProductCarousel
      client:load
      id="latest-news"
      title="LATEST NEWS"
      viewAllLink="#latest-news"
      products={newsProducts}
      sectionClass="mastery-section"
    />
  </main>

  <!-- Luxury Minimalist White Footer -->
  <Footer />

  <!-- Interactive Slide-Over Cart Drawer (DevTools auto-detect, INR subtotal) -->
  <CartDrawer client:load />
</Layout>
