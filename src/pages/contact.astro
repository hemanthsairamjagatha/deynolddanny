---
// src/pages/contact.astro
import StorefrontLayout from '../layouts/StorefrontLayout.astro';
---

<StorefrontLayout
  title="Contact Atelier | DEYNOLD DANNY"
  description="Connect with the DEYNOLD DANNY client concierge and bespoke tailoring team."
>
  <main class="min-h-screen bg-white">
    <div class="max-w-[1100px] mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-24">
      <nav aria-label="Breadcrumb" class="mb-8">
        <ol class="flex items-center gap-2 text-[11px] uppercase tracking-wider text-neutral-400 font-mono">
          <li>
            <a href="/" class="hover:text-black transition-colors">Home</a>
          </li>
          <li class="select-none">/</li>
          <li class="text-neutral-900 font-medium" aria-current="page">
            Contact
          </li>
        </ol>
      </nav>

      <div class="text-center max-w-xl mx-auto mb-16">
        <span class="text-[11px] uppercase tracking-[0.25em] font-mono text-neutral-400 block mb-2">
          Concierge & Bespoke Salon
        </span>
        <h1 class="text-3xl sm:text-4xl font-light tracking-tight text-neutral-900 font-serif mb-4">
          Contact Atelier
        </h1>
        <p class="text-xs text-neutral-500 leading-relaxed">
          Our client advisors are available for private consultations, sizing inquiries, and order assistance.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 sm:gap-16">
        <!-- Direct Contacts -->
        <div class="space-y-8 font-light text-neutral-800 text-sm">
          <div>
            <h2 class="text-xs uppercase tracking-widest font-mono text-neutral-400 mb-2">Private Client Inquiries</h2>
            <p class="font-serif text-lg text-neutral-900">concierge@deynolddanny.com</p>
            <p class="text-xs text-neutral-500 mt-1">Response within 24 business hours</p>
          </div>

          <div>
            <h2 class="text-xs uppercase tracking-widest font-mono text-neutral-400 mb-2">Atelier & Showroom</h2>
            <p class="font-serif text-lg text-neutral-900">DEYNOLD DANNY Flagship</p>
            <p class="text-xs text-neutral-600 mt-1">Via Monte Napoleone 8, 20121 Milano, Italy</p>
            <p class="text-xs text-neutral-500 mt-0.5">By private appointment only</p>
          </div>

          <div>
            <h2 class="text-xs uppercase tracking-widest font-mono text-neutral-400 mb-2">Telephone Assistance</h2>
            <p class="font-mono text-base text-neutral-900">+39 02 8736 5400</p>
            <p class="text-xs text-neutral-500 mt-1">Monday – Friday: 09:00 – 18:00 CET</p>
          </div>
        </div>

        <!-- Contact Form -->
        <form class="space-y-5 bg-[#faf8f5] p-8 rounded-sm border border-neutral-200/80" onsubmit="alert('Thank you. Your message has been received by the client concierge.'); return false;">
          <div class="space-y-1.5">
            <label class="block text-xs uppercase tracking-wider font-medium text-neutral-800 font-mono">
              Full Name *
            </label>
            <input
              type="text"
              required
              placeholder="Julian Vanderbilt"
              class="w-full h-11 px-4 bg-white border border-neutral-300 text-xs rounded-sm focus:outline-none focus:border-neutral-900"
            />
          </div>

          <div class="space-y-1.5">
            <label class="block text-xs uppercase tracking-wider font-medium text-neutral-800 font-mono">
              Email Address *
            </label>
            <input
              type="email"
              required
              placeholder="client@deynolddanny.com"
              class="w-full h-11 px-4 bg-white border border-neutral-300 text-xs rounded-sm focus:outline-none focus:border-neutral-900"
            />
          </div>

          <div class="space-y-1.5">
            <label class="block text-xs uppercase tracking-wider font-medium text-neutral-800 font-mono">
              Message *
            </label>
            <textarea
              rows="4"
              required
              placeholder="How may our concierge assist your sartorial journey?"
              class="w-full p-4 bg-white border border-neutral-300 text-xs rounded-sm focus:outline-none focus:border-neutral-900"
            ></textarea>
          </div>

          <button
            type="submit"
            class="w-full h-12 rounded-full bg-neutral-900 hover:bg-black text-white text-xs uppercase tracking-widest font-medium transition-all"
          >
            Send Inquiry
          </button>
        </form>
      </div>
    </div>
  </main>
</StorefrontLayout>
