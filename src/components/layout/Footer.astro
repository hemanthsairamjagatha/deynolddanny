---
// src/components/layout/Footer.astro
// Luxury Minimalist White Footer for DEYNOLD DANNY
---

<footer class="site-footer" id="footer">
  <div class="footer-container">
    <!-- Top 3-Column Navigation & Newsletter Section -->
    <div class="footer-top-grid">
      <!-- Column 1: GET TO KNOW US -->
      <div class="footer-col footer-col-nav">
        <h4 class="footer-col-title">GET TO KNOW US</h4>
        <ul class="footer-link-list">
          <li><button type="button" class="footer-link footer-search-trigger">SEARCH</button></li>
          <li><a href="/#thread-of-mastery" class="footer-link">ABOUT US</a></li>
          <li><a href="/contact" class="footer-link">CONTACT US</a></li>
        </ul>
      </div>

      <!-- Column 2: CUSTOMER CARE -->
      <div class="footer-col footer-col-nav">
        <h4 class="footer-col-title">CUSTOMER CARE</h4>
        <ul class="footer-link-list">
          <li><a href="/legal/shipping-returns" class="footer-link">RETURN AND EXCHANGE POLICY</a></li>
          <li><a href="/legal/privacy-policy" class="footer-link">PRIVACY POLICY</a></li>
          <li><a href="/legal/shipping-returns" class="footer-link">SHIPPING &amp; DELIVERY</a></li>
          <li><a href="/legal/terms" class="footer-link">TERMS AND CONDITION</a></li>
        </ul>
      </div>

      <!-- Column 3: Newsletter -->
      <div class="footer-col footer-col-newsletter">
        <h3 class="footer-heading-newsletter">Newsletter</h3>
        <p class="footer-text-newsletter">
          Never miss any news and be the first to know about sale and offers
        </p>
        <form class="footer-newsletter-form" id="newsletter-form">
          <div class="footer-input-group">
            <input
              type="email"
              id="newsletter-email"
              name="email"
              placeholder="Email"
              required
              class="footer-email-input"
              aria-label="Email address for newsletter"
            />
            <button type="submit" class="footer-submit-btn" aria-label="Subscribe to newsletter" id="newsletter-submit-btn">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </button>
          </div>
          <p id="newsletter-status" class="newsletter-status-msg" aria-live="polite"></p>
        </form>
      </div>
    </div>

    <!-- Bottom Row: Copyright, Attribution & Currency Selector -->
    <div class="footer-bottom-row">
      <div class="footer-copyright-wrap">
        <p class="footer-copyright-text">
          &copy; 2026 Deynold Danny, HANDCRAFTED BY <a href="https://www.pixenox.com" target="_blank" rel="noopener noreferrer" class="footer-pixenox-link">PIXENOX SOLUTIONS</a>
        </p>
      </div>

      <div class="footer-currency-wrap">
        <button type="button" class="footer-currency-btn" aria-label="Select currency and region">
          <span class="footer-currency-label">IN (INR ₹)</span>
          <svg class="footer-chevron-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </button>
      </div>
    </div>
  </div>
</footer>

<script>
  // Newsletter submission wiring
  const form = document.getElementById('newsletter-form') as HTMLFormElement | null;
  const emailInput = document.getElementById('newsletter-email') as HTMLInputElement | null;
  const statusMsg = document.getElementById('newsletter-status') as HTMLParagraphElement | null;
  const submitBtn = document.getElementById('newsletter-submit-btn') as HTMLButtonElement | null;

  if (form && emailInput && statusMsg && submitBtn) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = emailInput.value.trim();
      if (!email || !email.includes('@')) return;

      submitBtn.disabled = true;
      statusMsg.textContent = 'Subscribing...';
      statusMsg.style.color = '#737373';

      try {
        const res = await fetch('https://deynold-danny-backend.deynolddanny.workers.dev/api/newsletter/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email })
        });
        const data = await res.json();
        if (data.success) {
          statusMsg.textContent = 'Thank you for subscribing to DEYNOLD DANNY.';
          statusMsg.style.color = '#171717';
          emailInput.value = '';
        } else {
          statusMsg.textContent = data.error?.message || 'Subscription failed. Please try again.';
          statusMsg.style.color = '#dc2626';
        }
      } catch {
        statusMsg.textContent = 'Connection error. Please try again.';
        statusMsg.style.color = '#dc2626';
      } finally {
        submitBtn.disabled = false;
      }
    });
  }

  // Footer search trigger
  const searchTriggers = document.querySelectorAll('.footer-search-trigger');
  searchTriggers.forEach((btn) => {
    btn.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('open-search-modal'));
    });
  });
</script>

<style>
  /* --------------------------------------------------------------------------
     SITE FOOTER COMPONENT - PURE WHITE BACKGROUND
     -------------------------------------------------------------------------- */
  .site-footer {
    width: 100%;
    background-color: #ffffff !important;
    color: #111111;
    border-top: 1px solid #ebebeb;
    padding: clamp(3rem, 5vw, 4.5rem) 0 2rem;
    font-family: var(--font-primary, 'Plus Jakarta Sans'), -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    position: relative;
    box-sizing: border-box;
  }

  .footer-container {
    width: 100%;
    max-width: 1520px;
    margin: 0 auto;
    padding: 0 clamp(1.25rem, 4vw, 3.5rem);
    box-sizing: border-box;
  }

  .footer-top-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    padding-bottom: clamp(2.5rem, 4vw, 3.5rem);
    border-bottom: 1px solid #ebebeb;
  }

  @media (max-width: 768px) {
    .footer-top-grid {
      grid-template-columns: 1fr;
      gap: 2.25rem;
      padding-bottom: 2.5rem;
    }
  }

  .footer-col-title {
    font-family: var(--font-primary, 'Plus Jakarta Sans'), sans-serif;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #111111;
    margin: 0 0 1.25rem;
  }

  .footer-link-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .footer-link {
    font-family: var(--font-primary, 'Plus Jakarta Sans'), sans-serif;
    font-size: 0.6875rem;
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #4a4a4a;
    text-decoration: none;
    transition: color 0.18s ease;
    display: inline-block;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    text-align: left;
  }

  .footer-link:hover {
    color: #000000;
  }

  .footer-heading-newsletter {
    font-family: var(--font-serif, 'Bodoni Moda', serif);
    font-size: clamp(1.6rem, 2.2vw, 2.2rem);
    font-weight: 400;
    color: #111111;
    margin: 0 0 0.5rem;
    letter-spacing: -0.01em;
    line-height: 1.15;
  }

  .footer-text-newsletter {
    font-family: var(--font-primary, 'Plus Jakarta Sans'), sans-serif;
    font-size: 0.75rem;
    font-weight: 400;
    line-height: 1.5;
    color: #666666;
    margin: 0 0 1.25rem;
    max-width: 380px;
  }

  .footer-newsletter-form {
    width: 100%;
    max-width: 440px;
  }

  .footer-input-group {
    position: relative;
    width: 100%;
    display: flex;
    align-items: center;
    border: 1px solid #d4d4d4;
    background-color: #ffffff;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .footer-input-group:focus-within {
    border-color: #111111;
  }

  .footer-email-input {
    width: 100%;
    height: 44px;
    padding: 0 46px 0 14px;
    font-family: var(--font-primary, 'Plus Jakarta Sans'), sans-serif;
    font-size: 0.78rem;
    font-weight: 400;
    color: #111111;
    background: transparent;
    border: none;
    outline: none;
    box-sizing: border-box;
  }

  .footer-email-input::placeholder {
    color: #999999;
    font-weight: 300;
  }

  .footer-submit-btn {
    position: absolute;
    right: 0;
    top: 0;
    height: 44px;
    width: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: none;
    color: #111111;
    cursor: pointer;
    transition: transform 0.2s ease, color 0.18s ease;
  }

  .footer-submit-btn:hover {
    transform: translateX(2px);
    color: #000000;
  }

  .newsletter-status-msg {
    font-family: var(--font-mono, monospace);
    font-size: 0.6875rem;
    margin-top: 0.5rem;
    min-height: 1.25rem;
  }

  .footer-bottom-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: clamp(1.5rem, 2.5vw, 2rem);
    flex-wrap: wrap;
    gap: 1rem;
  }

  .footer-copyright-text {
    font-family: var(--font-primary, 'Plus Jakarta Sans'), sans-serif;
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #666666;
    margin: 0;
  }

  .footer-pixenox-link {
    color: #111111;
    text-decoration: underline;
    text-underline-offset: 3px;
    font-weight: 600;
    transition: opacity 0.18s ease;
  }

  .footer-pixenox-link:hover {
    opacity: 0.75;
  }

  .footer-currency-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: transparent;
    border: none;
    padding: 0;
    color: #111111;
    font-family: var(--font-primary, 'Plus Jakarta Sans'), sans-serif;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    cursor: pointer;
    transition: opacity 0.18s ease;
  }

  .footer-currency-btn:hover {
    opacity: 0.75;
  }
</style>
