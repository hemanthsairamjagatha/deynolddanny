---
// src/features/home/components/CategoryGrid.astro
import { mainCategories } from '../data/home-content';
---

<section class="editorial-categories-section" id="categories" aria-label="Explore Menswear Categories">
  <div class="editorial-categories-container">
    <div class="editorial-categories-grid">
      {mainCategories.map(cat => (
        <a href={cat.link} class="editorial-category-card" aria-label={`Scopri la collezione ${cat.title}`}>
          <div class="category-image-wrap">
            <img
              src={cat.image.startsWith('/') ? cat.image : `/${cat.image}`}
              alt={cat.subtitle}
              class="category-bg-img"
              width="762"
              height="762"
              loading="lazy"
            />
            <div class="category-gradient-overlay" aria-hidden="true" />
          </div>
          <div class="category-content-overlay image-text image-text-left">
            <h2 class="category-headline image-text-title">{cat.title}</h2>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

