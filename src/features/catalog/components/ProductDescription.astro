---
import type { ProductCardData } from '../types/product.types';

interface Props {
  product: ProductCardData;
}

const { product } = Astro.props;
---

<section class="border-t border-neutral-200/70 bg-[#faf8f5] py-14 lg:py-20 text-neutral-900" aria-labelledby="editorial-narrative-title">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-6">
    <span class="text-[11px] uppercase tracking-[0.25em] font-mono text-neutral-500 block">
      Sartorial Architecture & Craft
    </span>

    <h2 id="editorial-narrative-title" class="text-2xl sm:text-3xl font-light tracking-tight text-neutral-950 font-serif">
      The Making of {product.title}
    </h2>

    <p class="text-sm sm:text-base leading-relaxed text-neutral-700 max-w-2xl mx-auto font-light">
      {product.description || 'Wide leg trousers in cady with an elasticated waist for refined comfort. Filo diamante adds a luminous and discreet accent, enhancing the design with natural sophistication. Made in Italy through sustainable processes.'}
    </p>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 pt-8 border-t border-neutral-200/60 text-left">
      <div class="space-y-1">
        <span class="text-[11px] uppercase tracking-wider font-mono text-neutral-400 block">01 / Origin</span>
        <h3 class="text-xs uppercase font-medium tracking-wide text-neutral-900">Biella Textile Mills</h3>
        <p class="text-xs text-neutral-600 leading-normal">
          Woven in historic northern Italian mills renowned for fluidity and impeccable draping memory.
        </p>
      </div>

      <div class="space-y-1">
        <span class="text-[11px] uppercase tracking-wider font-mono text-neutral-400 block">02 / Detailing</span>
        <h3 class="text-xs uppercase font-medium tracking-wide text-neutral-900">Filo Diamante Micro-Loom</h3>
        <p class="text-xs text-neutral-600 leading-normal">
          Subtle shimmering micro-stitch woven along the seam line for understated luxury.
        </p>
      </div>

      <div class="space-y-1">
        <span class="text-[11px] uppercase tracking-wider font-mono text-neutral-400 block">03 / Silhouette</span>
        <h3 class="text-xs uppercase font-medium tracking-wide text-neutral-900">Relaxed Tailored Ease</h3>
        <p class="text-xs text-neutral-600 leading-normal">
          Clean pressed creases paired with an elasticated gathered waistband for day-to-evening versatility.
        </p>
      </div>
    </div>
  </div>
</section>

