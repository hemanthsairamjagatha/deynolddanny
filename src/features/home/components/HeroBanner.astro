---
// src/features/home/components/HeroBanner.astro
---

<section class="hero-section" id="hero">
  <!-- Hero Visual Banner: 2560 x 1080px (21:9) -->
  <div class="hero-banner-container">
    <img
      src="/hero-banner.jpg"
      alt="DEYNOLD DANNY - Modern Lifestyle Campaign 2026"
      class="hero-banner-img"
      width="2560"
      height="1429"
      loading="eager"
      decoding="sync"
      fetchpriority="high"
    />

    <!-- Direct Editorial Typography Overlay -->
    <div class="hero-overlay-content">
      <h1 class="hero-headline">
        <span class="hero-headline-sub">Modern Sartorial</span>
        <span class="hero-headline-main">DEYNOLD DANNY</span>
      </h1>
      <p class="hero-tagline">Autumn / Winter 2026 Architectural Tailoring</p>
    </div>
  </div>
</section>

<style>
  /* Base Hero Section Layout */
  .hero-section {
    position: relative;
    width: 100%;
    margin: 0;
    padding: 0;
    overflow: hidden;
    background-color: #ffffff;
  }

  /* Hero Visual Image Banner: 2560 x 1429px (16:9 widescreen) */
  .hero-banner-container {
    position: relative;
    width: 100%;
    max-width: 2560px;
    margin: 0 auto;
    aspect-ratio: 2560 / 1429;
  }

  .hero-banner-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  /* Editorial Overlay Content */
  .hero-overlay-content {
    position: absolute;
    bottom: clamp(2.5rem, 6vw, 5rem);
    left: clamp(1.5rem, 5vw, 4.5rem);
    z-index: 10;
    max-width: 600px;
  }

  .hero-headline {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .hero-headline-sub {
    font-family: 'Montserrat', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    font-size: clamp(0.65rem, 1.2vw, 0.8rem);
    text-transform: uppercase;
    letter-spacing: 0.3em;
    color: #ffffff;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.4);
  }

  .hero-headline-main {
    font-family: 'Montserrat', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    font-size: clamp(2.2rem, 5vw, 4rem);
    font-weight: 400;
    letter-spacing: 0.05em;
    line-height: 1.05;
    color: #ffffff;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.5);
  }

  .hero-tagline {
    font-family: 'Montserrat', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    font-size: clamp(0.75rem, 1.2vw, 0.9rem);
    font-weight: 300;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.9);
    margin-top: 0.75rem;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.4);
  }

  @media (max-width: 640px) {
    .hero-banner-container {
      aspect-ratio: 2560 / 1429;
      min-height: 0;
    }

    .hero-overlay-content {
      bottom: 0.9rem;
      left: 1rem;
    }

    .hero-headline-main {
      font-size: clamp(1.35rem, 5vw, 2.2rem);
    }

    .hero-tagline {
      margin-top: 0.35rem;
      font-size: 0.65rem;
    }
  }
</style>
