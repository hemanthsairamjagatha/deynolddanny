---
// src/pages/search.astro
import StorefrontLayout from '../layouts/StorefrontLayout.astro';
import { SearchPageExperience } from '../features/search/components/SearchPageExperience';

const title = 'Search Collection | DEYNOLD DANNY';
const description =
  'Search the DEYNOLD DANNY collection across tailoring, trousers, knitwear, shirts, outerwear, footwear, and accessories.';
---

<StorefrontLayout title={title} description={description} noindex={true}>
  <main id="main-content" class="min-h-screen bg-white">
    <div class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-20">
      <nav aria-label="Breadcrumb" class="mb-8">
        <ol class="flex items-center gap-2.5 text-[11px] uppercase tracking-wider text-neutral-400 font-mono">
          <li>
            <a href="/" class="hover:text-black transition-colors">Home</a>
          </li>
          <li aria-hidden="true">/</li>
          <li class="text-neutral-900 font-medium" aria-current="page">
            Search
          </li>
        </ol>
      </nav>

      <div class="mb-12 text-center max-w-xl mx-auto">
        <span class="text-[11px] uppercase tracking-[0.25em] font-mono text-neutral-400 block mb-2">
          Atelier Archive
        </span>
        <h1 class="text-3xl sm:text-4xl font-light tracking-tight text-neutral-900 font-serif mb-3">
          Search Collection
        </h1>
        <p class="text-xs text-neutral-500 font-mono tracking-wide">
          Explore garments by silhouette, fabric, or color
        </p>
      </div>

      <SearchPageExperience client:load />
    </div>
  </main>
</StorefrontLayout>
