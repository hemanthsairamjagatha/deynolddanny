{
  "name": "deynold-danny-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production",
    "db:migrate:local": "wrangler d1 migrations apply deynold-danny-db --local",
    "db:migrate:staging": "wrangler d1 migrations apply deynold-danny-db --remote --env staging",
    "db:migrate:production": "wrangler d1 migrations apply deynold-danny-db --remote --env production",
    "db:migrate:remote": "wrangler d1 migrations apply deynold-danny-db --remote",
    "db:migrate:list:local": "wrangler d1 migrations list deynold-danny-db --local",
    "db:migrate:list:remote": "wrangler d1 migrations list deynold-danny-db --remote",
    "type-check": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 tests/db-and-worker.test.mjs tests/payment-security.test.mjs tests/admin-parity-and-security.test.mjs"
  },
  "dependencies": {
    "hono": "^4.6.3",
    "@hono/zod-validator": "^0.4.1",
    "zod": "^3.23.8",
    "jose": "^5.9.6",
    "nanoid": "^5.0.7"
  },
  "devDependencies": {
    "wrangler": "^3.80.0",
    "@cloudflare/workers-types": "^4.20241127.0",
    "typescript": "^5.6.3"
  }
}

