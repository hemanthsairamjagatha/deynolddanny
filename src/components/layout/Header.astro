---
import CartTrigger from '../../features/cart/components/CartTrigger';
import SearchTrigger from '../../features/search/components/SearchTrigger';
import SearchDialog from '../../features/search/components/SearchDialog';
---

<header class="site-header" id="header">
  <!-- Pure CSS Drawer Trigger Checkbox -->
  <input type="checkbox" id="nav-toggle" class="nav-toggle-checkbox" aria-label="Toggle navigation drawer" />

  <!-- TIER 1: Menu, Logo, Utility Icons -->
  <div class="header-top-tier">
    <div class="container header-top-inner">
      <!-- Left: Minimal 2-Line Hamburger + MENU Label -->
      <div class="header-left">
        <label for="nav-toggle" class="header-menu-btn" aria-label="Toggle navigation menu">
          <span class="menu-icon-lines">
            <span class="menu-line"></span>
            <span class="menu-line"></span>
          </span>
          <span class="menu-text">MENU</span>
        </label>
      </div>

      <!-- Center: DEYNOLD DANNY Official Anchor Monogram Logo -->
      <div class="header-center">
        <a href="/" class="brand-logo" aria-label="DEYNOLD DANNY Home">
          <img src="/logo.png" alt="DEYNOLD DANNY" width="95" height="88" class="brand-logo-img" />
        </a>
      </div>

      <!-- Right: 4 Utility Icons (Search, Account, Wishlist/Heart, Bag) -->
      <div class="header-right">
        <!-- 1. Search Icon -->
        <SearchTrigger client:load />

        <!-- 2. Account Icon -->
        <a href="/account/sign-in" class="header-icon-link" aria-label="Client Account">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="7" r="4"></circle>
            <path d="M5.5 21a6.5 6.5 0 0 1 13 0"></path>
          </svg>
        </a>

        <!-- 3. Wishlist (Heart) Icon -->
        <a href="/wishlist" class="header-icon-link" aria-label="Saved Wishlist">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
          </svg>
        </a>

        <!-- 4. Shopping Bag Icon with Count Badge (React Hydrated) -->
        <CartTrigger client:load />
      </div>
    </div>
  </div>

  <!-- TIER 2: Centered Serif Navigation Links -->
  <nav class="header-nav-tier" aria-label="Primary Navigation">
    <div class="container">
      <ul class="nav-tier-list">
        <li><a href="/#thread-of-mastery" class="nav-tier-link">Women</a></li>
        <li><a href="/#thread-of-mastery" class="nav-tier-link">Men</a></li>
        <li><a href="/#style-space" class="nav-tier-link">Shop by Occasion</a></li>
        <li><a href="/#categories" class="nav-tier-link">Shop by Category</a></li>
        <li><a href="/#thread-of-mastery" class="nav-tier-link">Shop by Fabric</a></li>
        <li><a href="/#latest-news" class="nav-tier-link">Journal</a></li>
      </ul>
    </div>
  </nav>

  <!-- SIDE-DRAWER NAVIGATION (Pure CSS Toggle via #nav-toggle) -->
  <aside class="side-drawer" id="side-drawer" aria-label="Navigation Drawer">
    <!-- Drawer Header -->
    <div class="drawer-header">
      <img src="/logo.png" alt="DEYNOLD DANNY" class="drawer-brand-img" />
      <label for="nav-toggle" class="drawer-close-btn" aria-label="Close menu">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </label>
    </div>

    <!-- Drawer Content -->
    <div class="drawer-content">
      <div>
        <span class="drawer-section-title">The Collections</span>
        <div class="drawer-links-main">
          <a href="/#thread-of-mastery" class="drawer-link-serif">
            <span>Women</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
          <a href="/#thread-of-mastery" class="drawer-link-serif">
            <span>Men</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
          <a href="/#style-space" class="drawer-link-serif">
            <span>Shop by Occasion</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
          <a href="/#categories" class="drawer-link-serif">
            <span>Shop by Category</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
          <a href="/#thread-of-mastery" class="drawer-link-serif">
            <span>Shop by Fabric</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
          <a href="/#latest-news" class="drawer-link-serif">
            <span>Journal</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>
      </div>

      <div>
        <span class="drawer-section-title">Client Services</span>
        <div class="drawer-links-sub">
          <a href="/account/sign-in" class="drawer-link-sans">My Client Account</a>
          <a href="/wishlist" class="drawer-link-sans">Saved Wishlist</a>
          <a href="/contact" class="drawer-link-sans">Private Styling Concierge</a>
          <a href="/legal/shipping-returns" class="drawer-link-sans">Global Delivery & Returns</a>
          <a href="/contact" class="drawer-link-sans">Atelier Contact</a>
        </div>
      </div>
    </div>

    <!-- Drawer Footer -->
    <div class="drawer-footer">
      <span>Region: India &bull; INR (₹)</span>
      <span>&copy; 2026 DEYNOLD DANNY. All rights reserved.</span>
    </div>
  </aside>

  <!-- Backdrop overlay for drawer -->
  <label for="nav-toggle" class="nav-backdrop" aria-hidden="true"></label>

  <!-- Live Search Dialog Overlay -->
  <SearchDialog client:load />
</header>
