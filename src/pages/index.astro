---
import Layout from '../layouts/Layout.astro';
import Header from '../components/layout/Header.astro';
import HeroBanner from '../features/home/components/HeroBanner.astro';
import CategoryGrid from '../features/home/components/CategoryGrid.astro';
import ProductCarousel from '../features/catalog/components/ProductCarousel';
import StyleLayering from '../features/home/components/StyleLayering';
import CartDrawer from '../features/cart/components/CartDrawer';
import Footer from '../components/layout/Footer.astro';

import { fetchProducts } from '../features/catalog/api/catalog.api';
import {
  masteryProducts as defaultMastery,
  styleSpaceProducts as defaultStyleSpace
} from '../features/catalog/data/products';

const liveProducts = await fetchProducts();
const masteryProducts = liveProducts.length >= 4 ? liveProducts.slice(0, 4) : defaultMastery;
const styleSpaceProducts = liveProducts.length >= 8 ? liveProducts.slice(4, 8) : defaultStyleSpace;

const BEST_SELLER_CATEGORIES = [
  { label: 'ALL', value: 'all' },
  { label: 'TAILORING', value: 'tailoring' },
  { label: 'SHIRTS', value: 'shirts' },
  { label: 'TROUSERS', value: 'trousers' },
  { label: 'KNITWEAR', value: 'knitwear' },
  { label: 'OUTERWEAR', value: 'outerwear' },
  { label: 'FOOTWEAR', value: 'footwear' },
  { label: 'ACCESSORIES', value: 'accessories' }
];
const siteOrigin = Astro.site?.href.replace(/\/$/, '') || 'https://deynolddanny.com';
const organizationJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'DEYNOLD DANNY',
  url: siteOrigin,
  logo: `${siteOrigin}/logo.png`,
  sameAs: []
}).replace(/</g, '\\u003c');

const webSiteJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'DEYNOLD DANNY',
  url: siteOrigin,
  potentialAction: {
    '@type': 'SearchAction',
    target: `${siteOrigin}/search?q={search_term_string}`,
    'query-input': 'required name=search_term_string'
  }
}).replace(/</g, '\\u003c');
---

<Layout>
  <script type="application/ld+json" set:html={organizationJsonLd} />
  <script type="application/ld+json" set:html={webSiteJsonLd} />

  <!-- Header with Two Tiers, Mobile Drawer & Cart Trigger -->
  <Header />

  <!-- Main Content Body -->
  <main id="main-content">
    <!-- Hero Banner with Search Strip and Campaign Overlay -->
    <HeroBanner />

    <!-- 1. Our Best Sellers Carousel with Categories Subhead (Referenced Design) -->
    <ProductCarousel
      client:visible
      id="thread-of-mastery"
      title="Our Best Sellers"
      viewAllLink="/categories"
      products={masteryProducts}
      allCatalogProducts={liveProducts}
      categories={BEST_SELLER_CATEGORIES}
      sectionClass="mastery-section"
      sectionGroup="mastery"
    />

    <!-- 2. 6 Editorial Categories (3x2 Grid) -->
    <CategoryGrid />

    <!-- 3. New Arrival Carousel with Categories Subhead (Referenced Design) -->
    <ProductCarousel
      client:visible
      id="new-arrival"
      title="NEW ARRIVAL"
      viewAllLink="/categories"
      products={styleSpaceProducts}
      allCatalogProducts={liveProducts}
      categories={BEST_SELLER_CATEGORIES}
      sectionClass="mastery-section"
      sectionGroup="style_space"
    />

    <!-- 4. Style Layering Editorial Lookbook Section (Referenced Design) -->
    <div id="latest-news">
      <StyleLayering client:load />
    </div>
  </main>

  <!-- Luxury Minimalist White Footer -->
  <Footer />

  <!-- Interactive Slide-Over Cart Drawer (DevTools auto-detect, INR subtotal) -->
  <CartDrawer client:load />
</Layout>
