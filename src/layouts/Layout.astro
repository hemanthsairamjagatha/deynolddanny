---
// src/layouts/Layout.astro - Backward compatibility alias for BaseLayout
import BaseLayout from './BaseLayout.astro';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  canonical?: string;
  ogType?: 'website' | 'product' | 'article';
  ogImage?: string;
}

const props = Astro.props;
---

<BaseLayout {...props}>
  <slot />
</BaseLayout>
