---
// src/layouts/StorefrontLayout.astro
import BaseLayout from './BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import CartDrawer from '../features/cart/components/CartDrawer';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  canonical?: string;
  ogType?: 'website' | 'product' | 'article';
  ogImage?: string;
}

const { title, description, noindex, canonical, ogType, ogImage } = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  noindex={noindex}
  canonical={canonical}
  ogType={ogType}
  ogImage={ogImage}
>
  <Header />
  <slot />
  <Footer />
  <CartDrawer client:load />
</BaseLayout>

