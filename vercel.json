{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://deynold-danny-backend.deynolddanny.workers.dev/api/:path*"
    },
    {
      "source": "/media/:path*",
      "destination": "https://deynold-danny-backend.deynolddanny.workers.dev/media/:path*"
    },
    {
      "source": "/health",
      "destination": "https://deynold-danny-backend.deynolddanny.workers.dev/health"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/((?!assets/).*)",
      "destination": "/admin/index.html"
    }
  ],
  "headers": [
    {
      "source": "/admin/:path*",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ]
}
