---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "DEYNOLD DANNY | Italian High-End Menswear & Artisanal Sartorial Heritage",
  description = "Official DEYNOLD DANNY Online Flagship. Experience Italian quiet luxury, bespoke cashmere tailoring, handcrafted footwear, and sartorial overcoats."
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
  <meta name="description" content={description} />
  <title>{title}</title>

  <!-- Google Fonts Preconnect & Stylesheets -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&family=Manrope:wght@300;400;500;600;700&family=Bodoni+Moda:ital,opsz,wght@0,6..96,400;0,6..96,500;0,6..96,600;0,6..96,700;1,6..96,400&family=Trirong:ital,wght@0,300;0,400;0,500;1,300;1,400&family=Figtree:wght@300;400;500;600&family=Poppins:wght@400;500;600&family=Plus+Jakarta+Sans:wght@400;500;600&display=swap"
    rel="stylesheet"
  />

  <link rel="icon" type="image/png" href="/logo.png" />
</head>
<body>
  <slot />
</body>
</html>
