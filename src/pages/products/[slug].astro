---
// src/pages/products/[slug].astro
import StorefrontLayout from '../../layouts/StorefrontLayout.astro';
import { fetchProducts, fetchProductBySlug } from '../../features/catalog/api/catalog.api';
import { getProductSlug } from '../../features/catalog/utils/product.utils';
import { ProductDetailExperience } from '../../features/catalog/components/ProductDetailExperience';
import StyleItWith from '../../features/catalog/components/StyleItWith.astro';
import RelatedProducts from '../../features/catalog/components/RelatedProducts.astro';
import type { ProductCardData } from '../../features/catalog/types/product.types';

export async function getStaticPaths() {
  const products = await fetchProducts();
  return products.map((product) => {
    const slug = getProductSlug(product);
    return {
      params: { slug },
      props: { product }
    };
  });
}

interface Props {
  product?: ProductCardData;
}

const { slug } = Astro.params;
const product = Astro.props.product || (slug ? await fetchProductBySlug(slug) : undefined);

if (!product) {
  return Astro.redirect('/404');
}

const pageTitle = `${product.title} | DEYNOLD DANNY`;
const pageDescription = product.description || `Explore ${product.title} in the DEYNOLD DANNY luxury collection.`;

// JSON-LD structured data
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": product.title,
  "image": product.images && product.images.length > 0 ? product.images : [product.defaultImg],
  "description": pageDescription,
  "sku": product.sku || product.id,
  "brand": {
    "@type": "Brand",
    "name": "DEYNOLD DANNY"
  },
  "offers": {
    "@type": "Offer",
    "priceCurrency": product.price.includes('€') ? 'EUR' : 'INR',
    "price": product.priceNum,
    "availability": "https://schema.org/InStock",
    "itemCondition": "https://schema.org/NewCondition"
  }
};
---

<StorefrontLayout title={pageTitle} description={pageDescription}>
  {/* SEO JSON-LD */}
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <main class="min-h-screen bg-white">
    {/* Primary Interactive Island: Split-screen Gallery + Sticky Purchase Panel */}
    <ProductDetailExperience client:load product={product} />

    {/* Section 1: Style It With Merchandising */}
    {product.styleItWith && product.styleItWith.length > 0 && (
      <StyleItWith items={product.styleItWith} />
    )}

    {/* Section 2: Related Products / Suggestions */}
    {product.relatedProducts && product.relatedProducts.length > 0 && (
      <RelatedProducts items={product.relatedProducts} title="More Suggestions" />
    )}
  </main>
</StorefrontLayout>

