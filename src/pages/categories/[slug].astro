export async function getStaticPaths() {
  const allProducts = await fetchProducts();

  return CATEGORIES.map((cat) => {
    const catMatched = allProducts.filter(cat.matcher);

    return {
      params: { slug: cat.slug },
      props: {
        category: cat,
        products: catMatched,
        allCategories: CATEGORIES.slice(0, 7) // Primary category filter pills
      }
    };
  });
}

const { category, products, allCategories } = Astro.props;

const pageTitle = `${category.title} | DEYNOLD DANNY`;
const pageDescription = category.description;

const serializableCategory = {
  slug: category.slug,
  title: category.title,
  subtitle: category.subtitle,
  description: category.description,
  heroEditorialImg: category.heroEditorialImg,
  heroEditorialTitle: category.heroEditorialTitle,
  heroEditorialSubtitle: category.heroEditorialSubtitle,
  duoEditorialLeftImg: category.duoEditorialLeftImg,
  duoEditorialLeftTitle: category.duoEditorialLeftTitle,
  duoEditorialRightImg: category.duoEditorialRightImg,
  duoEditorialRightTitle: category.duoEditorialRightTitle,
};

const serializableTabs = allCategories.map((c: CategoryMeta) => ({
  slug: c.slug,
  title: c.title,
}));

const siteOrigin = (Astro.site?.toString() || 'https://deynolddanny.com').replace(/\/$/, '');
const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": `${siteOrigin}/` },
    { "@type": "ListItem", "position": 2, "name": "Categories", "item": `${siteOrigin}/categories` },
    { "@type": "ListItem", "position": 3, "name": category.title, "item": `${siteOrigin}/categories/${category.slug}` }
  ]
};
---

<StorefrontLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd).replace(/</g, '\\u003c')} />
  <main id="main-content" class="min-h-screen bg-white text-black">
    <LiveCategoryListing
      client:load
      initialCategory={serializableCategory}
      initialProducts={products}
      initialTabs={serializableTabs}
    />
  </main>
</StorefrontLayout>
