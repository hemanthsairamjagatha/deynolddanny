---
// src/features/home/components/HeroBanner.astro
---

<section class="hero-section" id="hero">
  <!-- Hero Visual Banner: Exact Size 1520.8 x 855 -->
  <div class="hero-banner-container">
    <img
      src="/hero-banner.jpg"
      alt="DEYNOLD DANNY - Modern Lifestyle Campaign 2026"
      class="hero-banner-img"
      width="1521"
      height="855"
      loading="eager"
    />

    <!-- Direct Editorial Typography Overlay -->
    <div class="hero-overlay-content">
      <h1 class="hero-headline">
        <span class="hero-headline-sub">Modern Sartorial</span>
        <span class="hero-headline-main">DEYNOLD DANNY</span>
      </h1>
      <p class="hero-tagline">Autumn / Winter 2026 Architectural Tailoring</p>
    </div>
  </div>
</section>

<style>
  /* Base Hero Section Layout */
  .hero-section {
    position: relative;
    width: 100%;
    margin: 0;
    padding: 0;
    overflow: hidden;
    background-color: #faf9f6;
  }

  /* Hero Visual Image Banner */
  .hero-banner-container {
    position: relative;
    width: 100%;
    max-width: 1521px;
    margin: 0 auto;
    aspect-ratio: 1521 / 855;
    min-height: 520px;
  }

  .hero-banner-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 25%;
    display: block;
  }

  /* Editorial Overlay Content */
  .hero-overlay-content {
    position: absolute;
    bottom: clamp(2.5rem, 6vw, 5rem);
    left: clamp(1.5rem, 5vw, 4.5rem);
    z-index: 10;
    max-width: 600px;
  }

  .hero-headline {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .hero-headline-sub {
    font-family: var(--font-mono, monospace);
    font-size: clamp(0.65rem, 1.2vw, 0.8rem);
    text-transform: uppercase;
    letter-spacing: 0.3em;
    color: #ffffff;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.4);
  }

  .hero-headline-main {
    font-family: var(--font-serif, 'Bodoni Moda', serif);
    font-size: clamp(2.2rem, 5vw, 4rem);
    font-weight: 400;
    letter-spacing: 0.05em;
    line-height: 1.05;
    color: #ffffff;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.5);
  }

  .hero-tagline {
    font-family: var(--font-primary, 'Plus Jakarta Sans'), sans-serif;
    font-size: clamp(0.75rem, 1.2vw, 0.9rem);
    font-weight: 300;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.9);
    margin-top: 0.75rem;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.4);
  }

  @media (max-width: 640px) {
    .hero-banner-container {
      min-height: 420px;
    }
  }
</style>
