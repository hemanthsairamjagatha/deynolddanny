---
// src/pages/size-guide.astro
// Dedicated Size & Measurements Guide page powered by live D1 Size Guides from Commerce OS Admin
import StorefrontLayout from '../layouts/StorefrontLayout.astro';
import { LiveSizeGuideExperience } from '../features/catalog/size-guide/LiveSizeGuideExperience';
---

<StorefrontLayout
  title="Size & Measurements Guide | DEYNOLD DANNY"
  description="Explore precision garment measurement charts, international conversions, and tailoring recommendations across the House of DEYNOLD DANNY collections."
>
  <main id="main-content" class="min-h-screen bg-white">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 pt-10 pb-24">
      {/* Breadcrumbs */}
      <nav aria-label="Breadcrumb" class="mb-8">
        <ol class="flex items-center space-x-2 text-xs font-mono tracking-widest text-neutral-400 uppercase">
          <li>
            <a href="/" class="hover:text-black transition-colors">Home</a>
          </li>
          <li aria-hidden="true">/</li>
          <li class="text-neutral-900 font-medium" aria-current="page">Size Guide</li>
        </ol>
      </nav>

      {/* Header */}
      <div class="mb-12">
        <span class="text-xs font-mono uppercase tracking-[0.25em] text-neutral-400 block mb-2">
          Atelier Specifications
        </span>
        <h1 class="text-3xl sm:text-4xl font-light tracking-tight text-neutral-950 font-display">
          Size &amp; Measurements Guide
        </h1>
        <p class="mt-3 text-sm text-neutral-600 max-w-2xl leading-relaxed font-light">
          Our garments are cut with architectural precision, balancing noble natural fibers with contemporary proportions. Consult our detailed dimension tables below or reach out to our client concierge for bespoke tailoring assistance.
        </p>
      </div>

      {/* Live Interactive Size Guide */}
      <LiveSizeGuideExperience client:load />

      {/* Concierge Assistance Banner */}
      <div class="mt-16 p-8 bg-neutral-950 text-white flex flex-col sm:flex-row items-center justify-between gap-6">
        <div>
          <span class="text-[10px] font-mono uppercase tracking-[0.2em] text-neutral-400 block mb-1">
            Private Atelier Assistance
          </span>
          <h3 class="text-xl font-light tracking-wide">
            Need Guidance on Sizing or Alterations?
          </h3>
          <p class="text-xs text-neutral-400 mt-1 max-w-xl">
            Our private client concierge provides customized garment measurements, fit recommendations, and bespoke alteration consultations.
          </p>
        </div>
        <a
          href="/contact"
          class="inline-block px-6 py-3 border border-white text-xs font-mono uppercase tracking-[0.18em] text-white hover:bg-white hover:text-black transition-colors whitespace-nowrap"
        >
          Contact Concierge
        </a>
      </div>
    </div>
  </main>
</StorefrontLayout>
